<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Invisible launcher screen; only system dialogs/toasts show, styled by the device default theme, following system light/dark mode. -->
    <style name="Theme.BCam" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Opaque standalone updater; recording/settings keep their translucent theme. -->
    <style name="Theme.BCam.Updates" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
